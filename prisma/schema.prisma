generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  VISITOR
  PATIENT
  DENTIST
  CLINIC_MANAGER
  MODERATOR
  SUPER_ADMIN
}

enum VerificationStatus {
  DRAFT
  PENDING_SUBMISSION
  IN_REVIEW
  ADDITIONAL_DOCUMENT_REQUIRED
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AppointmentStatus {
  PENDING
  VIEWED_BY_CLINIC
  INFO_REQUESTED
  APPROVED
  ALTERNATIVE_TIME_PROPOSED
  PATIENT_CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum ModerationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum GoogleSyncStatus {
  NEVER_SYNCED
  OK
  FAILED
  RATE_LIMITED
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String?
  role               UserRole            @default(PATIENT)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  profile            UserProfile?
  patientProfile     PatientProfile?
  clinicMemberships  ClinicTeamMember[]
  favorites          Favorite[]
  comparisonLists    ComparisonList[]
  appointmentRequests AppointmentRequest[]
  quoteRequests      QuoteRequest[]
  messages           Message[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  consentRecords     ConsentRecord[]
  deletionRequests   DataDeletionRequest[]

  @@index([role])
  @@index([createdAt])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  fullName  String
  phone     String?
  locale    String   @default("tr")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PatientProfile {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  marketingConsent        Boolean  @default(false)
  healthDataConsentAt     DateTime?
  notificationPreferences Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Clinic {
  id                 String              @id @default(cuid())
  slug               String              @unique
  name               String
  description        String?
  foundingYear       Int?
  logoUrl            String?
  coverImageUrl      String?
  city               String
  district           String
  neighborhood       String?
  address            String
  latitude           Decimal?            @db.Decimal(9, 6)
  longitude          Decimal?            @db.Decimal(9, 6)
  phone              String?
  whatsapp           String?
  email              String?
  website            String?
  isPublished        Boolean             @default(false)
  isSponsored        Boolean             @default(false)
  verificationStatus VerificationStatus  @default(DRAFT)
  emergencyService   Boolean             @default(false)
  wheelchairAccess   Boolean             @default(false)
  parking            Boolean             @default(false)
  onlineConsultation Boolean             @default(false)
  childFriendly      Boolean             @default(false)
  sedation           Boolean             @default(false)
  generalAnesthesia  Boolean             @default(false)
  languages          String[]
  paymentOptions     String[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  branches           ClinicBranch[]
  teamMembers        ClinicTeamMember[]
  dentists           Dentist[]
  treatments         ClinicTreatment[]
  prices             TreatmentPrice[]
  packages           TreatmentPackage[]
  campaigns          Campaign[]
  photos             ClinicPhoto[]
  cases              CaseGallery[]
  googleConnection   GooglePlaceConnection?
  favorites          Favorite[]
  comparisonItems    ComparisonItem[]
  appointmentRequests AppointmentRequest[]
  quoteRequestClinics QuoteRequestClinic[]
  conversations      Conversation[]
  verificationApplications VerificationApplication[]
  reports            Report[]
  analyticsEvents    AnalyticsEvent[]

  @@index([slug])
  @@index([city, district])
  @@index([verificationStatus, isPublished])
  @@index([createdAt])
}

model ClinicBranch {
  id        String   @id @default(cuid())
  clinicId  String
  name      String
  city      String
  district  String
  address   String
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  prices    TreatmentPrice[]

  @@index([clinicId])
  @@index([city, district])
}

model ClinicTeamMember {
  id        String   @id @default(cuid())
  clinicId  String
  userId    String
  role      UserRole @default(CLINIC_MANAGER)
  createdAt DateTime @default(now())
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([clinicId, userId])
}

model Dentist {
  id                 String             @id @default(cuid())
  slug               String             @unique
  clinicId           String?
  fullName           String
  title              String
  photoUrl           String?
  university         String?
  graduationYear     Int?
  experienceYears    Int                @default(0)
  about              String?
  languages          String[]
  acceptsChildren    Boolean            @default(false)
  acceptsInternationalPatients Boolean  @default(false)
  onlineConsultation Boolean            @default(false)
  verificationStatus VerificationStatus @default(DRAFT)
  googlePlaceId      String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  clinic             Clinic?            @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  education          DentistEducation[]
  certificates       DentistCertificate[]
  specialties        DentistSpecialty[]
  photos             DentistPhoto[]
  prices             TreatmentPrice[]
  appointmentRequests AppointmentRequest[]

  @@index([slug])
  @@index([verificationStatus])
  @@index([clinicId])
}

model DentistEducation {
  id        String  @id @default(cuid())
  dentistId String
  school    String
  degree    String?
  year      Int?
  dentist   Dentist @relation(fields: [dentistId], references: [id], onDelete: Cascade)
}

model DentistCertificate {
  id        String  @id @default(cuid())
  dentistId String
  name      String
  issuer    String?
  year      Int?
  fileKey   String?
  dentist   Dentist @relation(fields: [dentistId], references: [id], onDelete: Cascade)
}

model Specialty {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  description String?
  dentists    DentistSpecialty[]
  treatments  Treatment[]
}

model DentistSpecialty {
  id          String             @id @default(cuid())
  dentistId   String
  specialtyId String
  isVerified  Boolean            @default(false)
  status      VerificationStatus @default(DRAFT)
  dentist     Dentist            @relation(fields: [dentistId], references: [id], onDelete: Cascade)
  specialty   Specialty          @relation(fields: [specialtyId], references: [id], onDelete: Restrict)

  @@unique([dentistId, specialtyId])
}

model TreatmentCategory {
  id          String              @id @default(cuid())
  slug        String              @unique
  name        String
  description String?
  parentId    String?
  parent      TreatmentCategory?  @relation("TreatmentCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    TreatmentCategory[] @relation("TreatmentCategoryTree")
  treatments  Treatment[]
}

model Treatment {
  id                   String            @id @default(cuid())
  slug                 String            @unique
  categoryId           String
  specialtyId          String?
  name                 String
  description          String?
  averageSessions      Int?
  estimatedDuration    String?
  pricingUnit          String
  supportsStartingPrice Boolean          @default(true)
  supportsMinMax       Boolean           @default(true)
  patientInfoText      String?
  riskWarning          String?
  category             TreatmentCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  specialty            Specialty?        @relation(fields: [specialtyId], references: [id], onDelete: SetNull)
  clinicTreatments     ClinicTreatment[]
  prices               TreatmentPrice[]
  packages             TreatmentPackage[]

  @@index([categoryId])
  @@index([specialtyId])
}

model ClinicTreatment {
  id          String           @id @default(cuid())
  clinicId    String
  treatmentId String
  status      ModerationStatus @default(PENDING)
  clinic      Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatment   Treatment        @relation(fields: [treatmentId], references: [id], onDelete: Restrict)

  @@unique([clinicId, treatmentId])
}

model TreatmentPrice {
  id                  String           @id @default(cuid())
  clinicId            String
  branchId            String?
  treatmentId         String
  dentistId           String?
  minPrice            Decimal?         @db.Decimal(12, 2)
  maxPrice            Decimal?         @db.Decimal(12, 2)
  fixedPrice          Decimal?         @db.Decimal(12, 2)
  campaignPrice       Decimal?         @db.Decimal(12, 2)
  normalPrice         Decimal?         @db.Decimal(12, 2)
  currency            String           @default("TRY")
  priceUnit           String
  vatIncluded         Boolean          @default(true)
  examIncluded        Boolean          @default(false)
  imagingIncluded     Boolean          @default(false)
  materialOrBrand     String?
  validFrom           DateTime?
  validUntil          DateTime?
  packageContent      String?
  extraFeeConditions  String?
  description         String?
  moderationStatus    ModerationStatus @default(PENDING)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  clinic              Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  branch              ClinicBranch?    @relation(fields: [branchId], references: [id], onDelete: SetNull)
  treatment           Treatment        @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  dentist             Dentist?         @relation(fields: [dentistId], references: [id], onDelete: SetNull)

  @@index([clinicId])
  @@index([treatmentId])
  @@index([minPrice, maxPrice, fixedPrice])
  @@index([moderationStatus])
  @@index([updatedAt])
}

model TreatmentPackage {
  id          String   @id @default(cuid())
  clinicId    String
  treatmentId String?
  name        String
  description String?
  price       Decimal? @db.Decimal(12, 2)
  currency    String   @default("TRY")
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  treatment   Treatment? @relation(fields: [treatmentId], references: [id], onDelete: SetNull)
}

model Campaign {
  id          String   @id @default(cuid())
  clinicId    String
  title       String
  description String?
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean  @default(true)
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model ClinicPhoto {
  id       String @id @default(cuid())
  clinicId String
  url      String
  alt      String?
  clinic   Clinic @relation(fields: [clinicId], references: [id], onDelete: Cascade)
}

model DentistPhoto {
  id        String  @id @default(cuid())
  dentistId String
  url       String
  alt       String?
  dentist   Dentist @relation(fields: [dentistId], references: [id], onDelete: Cascade)
}

model CaseGallery {
  id          String  @id @default(cuid())
  clinicId    String
  title       String
  description String?
  beforeKey   String?
  afterKey    String?
  clinic      Clinic  @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  consent     CaseGalleryConsent?
}

model CaseGalleryConsent {
  id            String      @id @default(cuid())
  caseGalleryId String      @unique
  consentKey    String
  consentedAt   DateTime
  caseGallery   CaseGallery @relation(fields: [caseGalleryId], references: [id], onDelete: Cascade)
}

model GooglePlaceConnection {
  id                         String           @id @default(cuid())
  clinicId                   String           @unique
  googlePlaceId              String           @unique
  googleBusinessLocationId   String?
  googleRating               Decimal?         @db.Decimal(2, 1)
  googleUserRatingsTotal     Int?
  googleMapsUrl              String?
  googleWriteReviewUrl       String?
  googleLastSyncedAt         DateTime?
  googleSyncStatus           GoogleSyncStatus @default(NEVER_SYNCED)
  googleSyncError            String?
  googleMatchConfidence      Decimal?         @db.Decimal(3, 2)
  googleConnectedByClinic    Boolean          @default(false)
  googleOauthConnectionId    String?
  clinic                     Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  reviews                    GoogleReviewCache[]

  @@index([googlePlaceId])
  @@index([googleRating])
  @@index([googleUserRatingsTotal])
}

model GoogleReviewCache {
  id                 String                @id @default(cuid())
  connectionId       String
  authorDisplayName  String
  rating             Int
  relativeTime       String?
  text               String?
  clinicResponse     String?
  sourceUrl          String?
  fetchedAt          DateTime              @default(now())
  connection         GooglePlaceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  clinicId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([userId, clinicId])
}

model ComparisonList {
  id        String           @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     ComparisonItem[]
}

model ComparisonItem {
  id               String         @id @default(cuid())
  comparisonListId String
  clinicId         String
  createdAt        DateTime       @default(now())
  comparisonList   ComparisonList @relation(fields: [comparisonListId], references: [id], onDelete: Cascade)
  clinic           Clinic         @relation(fields: [clinicId], references: [id], onDelete: Cascade)

  @@unique([comparisonListId, clinicId])
}

model AppointmentRequest {
  id              String                    @id @default(cuid())
  userId          String?
  clinicId        String
  dentistId       String?
  treatmentName   String
  preferredDate   DateTime?
  note            String?
  status          AppointmentStatus         @default(PENDING)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  user            User?                     @relation(fields: [userId], references: [id], onDelete: SetNull)
  clinic          Clinic                    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  dentist         Dentist?                  @relation(fields: [dentistId], references: [id], onDelete: SetNull)
  history         AppointmentStatusHistory[]
}

model AppointmentStatusHistory {
  id                   String             @id @default(cuid())
  appointmentRequestId String
  status               AppointmentStatus
  note                 String?
  createdAt            DateTime           @default(now())
  appointmentRequest   AppointmentRequest @relation(fields: [appointmentRequestId], references: [id], onDelete: Cascade)
}

model QuoteRequest {
  id                      String               @id @default(cuid())
  userId                  String?
  treatmentName           String
  complaint               String
  city                    String
  preferredDate           DateTime?
  budgetMin               Decimal?             @db.Decimal(12, 2)
  budgetMax               Decimal?             @db.Decimal(12, 2)
  hasPriorExam            Boolean              @default(false)
  hasImaging              Boolean              @default(false)
  contactPreference       String
  kvkkConsent             Boolean
  healthDataConsent       Boolean
  createdAt               DateTime             @default(now())
  user                    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  selectedClinics         QuoteRequestClinic[]
}

model QuoteRequestClinic {
  id             String          @id @default(cuid())
  quoteRequestId String
  clinicId       String
  quoteRequest   QuoteRequest    @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  clinic         Clinic          @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  response       QuoteResponse?

  @@unique([quoteRequestId, clinicId])
}

model QuoteResponse {
  id                   String             @id @default(cuid())
  quoteRequestClinicId String             @unique
  estimatedMinPrice    Decimal?           @db.Decimal(12, 2)
  estimatedMaxPrice    Decimal?           @db.Decimal(12, 2)
  includedItems        String?
  estimatedSessions    Int?
  estimatedDuration    String?
  firstAvailableDate   DateTime?
  validUntil           DateTime?
  note                 String?
  createdAt            DateTime           @default(now())
  quoteRequestClinic   QuoteRequestClinic @relation(fields: [quoteRequestClinicId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        String    @id @default(cuid())
  clinicId  String
  userId    String?
  createdAt DateTime  @default(now())
  clinic    Clinic    @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  messages  Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String?
  body           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationApplication {
  id        String                 @id @default(cuid())
  clinicId  String
  status    VerificationStatus     @default(PENDING_SUBMISSION)
  note      String?
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  clinic    Clinic                 @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  documents VerificationDocument[]
}

model VerificationDocument {
  id                        String                  @id @default(cuid())
  verificationApplicationId String
  documentType              String
  privateObjectKey          String
  createdAt                 DateTime                @default(now())
  application               VerificationApplication @relation(fields: [verificationApplicationId], references: [id], onDelete: Cascade)
}

model Report {
  id        String           @id @default(cuid())
  clinicId  String?
  reason    String
  details   String?
  status    ModerationStatus @default(PENDING)
  createdAt DateTime         @default(now())
  clinic    Clinic?          @relation(fields: [clinicId], references: [id], onDelete: SetNull)
}

model ModerationAction {
  id        String   @id @default(cuid())
  actorId   String?
  target    String
  action    String
  reason    String?
  createdAt DateTime @default(now())
}

model SubscriptionPlan {
  id            String         @id @default(cuid())
  slug          String         @unique
  name          String
  monthlyPrice  Decimal        @db.Decimal(12, 2)
  currency      String         @default("TRY")
  subscriptions Subscription[]
}

model Subscription {
  id        String           @id @default(cuid())
  planId    String
  clinicId  String?
  status    String
  startsAt  DateTime
  endsAt    DateTime?
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  payments  Payment[]
}

model Payment {
  id             String       @id @default(cuid())
  subscriptionId String
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("TRY")
  status         String
  createdAt      DateTime     @default(now())
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  clinicId  String?
  type      String
  metadata  Json?
  createdAt DateTime @default(now())
  clinic    Clinic?  @relation(fields: [clinicId], references: [id], onDelete: SetNull)
}

model SearchLog {
  id        String   @id @default(cuid())
  query     String?
  city      String?
  district  String?
  filters   Json?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  target    String
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
}

model ConsentRecord {
  id             String   @id @default(cuid())
  userId         String
  consentType    String
  consentVersion String
  granted        Boolean
  ipAddress      String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DataDeletionRequest {
  id        String   @id @default(cuid())
  userId    String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiCredential {
  id        String   @id @default(cuid())
  provider  String
  keyRef    String
  status    String
  createdAt DateTime @default(now())
}

model BackgroundJob {
  id        String   @id @default(cuid())
  type      String
  status    String
  payload   Json?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
