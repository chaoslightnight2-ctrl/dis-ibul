# =============================================================================
# DişçiBul — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# =============================================================================

# --- Application -----------------------------------------------------------
APP_BRAND_NAME="DişçiBul"
APP_BASE_URL="http://localhost:3000"            # Production: MUST be https://yourdomain.com

# --- Database (PostgreSQL + PostGIS) ---------------------------------------
DATABASE_URL="postgresql://discibul:discibul@localhost:5432/discibul?schema=public"

# --- Redis (caching, rate limiting, sessions) --------------------------------
REDIS_URL="redis://localhost:6379"

# --- Authentication (Better Auth) -------------------------------------------
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-to-a-random-64-char-hex-string"
BETTER_AUTH_URL="${APP_BASE_URL}"              # Override if behind proxy
AUTH_ALLOWED_HOSTS="yourdomain.com"             # Comma-separated for production
# Encrypt server action data (Next.js 16). Generate with: openssl rand -hex 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=""

# --- Email (Resend) ---------------------------------------------------------
# Options: disabled | resend | mock (dev only)
EMAIL_PROVIDER="disabled"
RESEND_API_KEY="re_..."                        # Required if EMAIL_PROVIDER=resend
EMAIL_FROM="DişçiBul <iletisim@yourdomain.com>" # Required if EMAIL_PROVIDER=resend
EMAIL_REQUIRE_VERIFICATION="false"             # Set "true" to require email verification
EMAIL_MOCK_LOG_ACTION_URL="false"              # Dev only: log action URLs in mock mode

# --- Google Maps / Places ---------------------------------------------------
# Options: disabled | google
GOOGLE_PROVIDER="disabled"
GOOGLE_MAPS_API_KEY=""                         # Required if GOOGLE_PROVIDER=google
GOOGLE_PLACES_PAGE_SIZE=20                     # 1–20
GOOGLE_PLACES_TIMEOUT_MS=8000                  # 1000–20000
GOOGLE_PLACES_MAX_REQUESTS_PER_MONTH=900       # Monthly free tier budget cap
GOOGLE_PLACES_MAX_REQUESTS_PER_MINUTE=90       # Per-minute rate limit
GOOGLE_PLACES_SEARCH_CACHE_SECONDS=1800
GOOGLE_PLACES_DETAILS_CACHE_SECONDS=3600

# --- Google Business Profile (OAuth) ----------------------------------------
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""
# 32-byte base64 key for encrypting OAuth tokens. Generate: openssl rand -base64 32
GOOGLE_BUSINESS_TOKEN_ENCRYPTION_KEY=""

# --- OpenStreetMap (free clinic data) ---------------------------------------
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_TIMEOUT_MS=60000                          # 2000–90000 (büyük şehirler için yüksek)
OSM_MAX_REQUESTS_PER_MINUTE=30                 # 1–120
OSM_MAX_RESULTS=500                            # 10–500 (per-city, artırıldı)
OSM_MAX_RESULTS_TURKEY=2000                    # 20–2000 (country-wide, artırıldı)
OSM_GEOCODE_CACHE_SECONDS=604800               # 1 hour – 30 days
OSM_RESULT_CACHE_SECONDS=1800                  # 5 min – 24 hours

# --- Object Storage (file uploads) -------------------------------------------
# Options: disabled | local | s3
OBJECT_STORAGE_PROVIDER="local"
PRIVATE_STORAGE_LOCAL_PATH=".data/private"     # Local storage path
S3_BUCKET=""                                   # Required if OBJECT_STORAGE_PROVIDER=s3
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""                                 # Optional: MinIO or custom endpoint
S3_FORCE_PATH_STYLE="false"
PRIVATE_FILE_RETENTION_DAYS=180                # 1–3650

# --- File Virus Scanner ------------------------------------------------------
# Options: disabled | mock | clamav
FILE_SCAN_PROVIDER="disabled"
CLAMAV_HOST="clamav"
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=10000

# --- Billing (iyzico) --------------------------------------------------------
# Options: disabled | iyzico
BILLING_PROVIDER="disabled"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_MERCHANT_ID=""
IYZICO_API_BASE_URL="https://sandbox-api.iyzipay.com"
IYZICO_PLAN_GROWTH_REF=""                      # Plan reference in iyzico
IYZICO_PLAN_PRO_REF=""                         # Plan reference in iyzico

# --- Runtime ---------------------------------------------------------------
NODE_ENV="development"                         # production | development
STRICT_RUNTIME_ENV="false"                     # Set true: fails on invalid env vars
DEPLOYMENT_VERSION="local"                     # Git SHA or release tag for health checks

# --- Legal / Brand ----------------------------------------------------------
LEGAL_CONTACT_EMAIL="destek@discibul.com"
